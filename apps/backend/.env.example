# Wally Backend — Environment Variables
# Copy this file to .env.local and fill in the values.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── LLM API Keys ─────────────────────────────────────────────────────────────
# Required.
ANTHROPIC_API_KEY=sk-ant-...

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_SITE_PER_MINUTE=30
RATE_LIMIT_PER_SITE_PER_DAY=1000

# ── License Validation ────────────────────────────────────────────────────────
# Set to 'true' in development to skip license checks and use a mock pro license.
SKIP_LICENSE_VALIDATION=true

# ── Supabase ──────────────────────────────────────────────────────────────────
# Required when SKIP_LICENSE_VALIDATION=false.
# Use the service_role secret key (bypasses RLS) from the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Admin ─────────────────────────────────────────────────────────────────────
# Shared secret used by the admin dashboard to access protected endpoints.
# Generate a long random string (e.g. openssl rand -hex 32) and use the same
# value in the frontend's ADMIN_API_KEY env var.
ADMIN_API_KEY=

# ── Knowledge Directory ───────────────────────────────────────────────────────
# Absolute path to the directory containing *.md knowledge files.
# Defaults to apps/backend/src/knowledge/ relative to the project root.
# Useful in development when pointing to the old backend knowledge dir:
# KNOWLEDGE_DIR=/path/to/wally/backend/src/knowledge
