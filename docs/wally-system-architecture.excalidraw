      "updated": 1710100000000,
      "link": null,
      "locked": false,
      "text": "Chat Flow:  User  ->  Plugin  ->  Backend (builds prompt)  ->  LLM  ->  Backend  ->  Plugin (SSE stream)  ->  User\nTool Loop:  LLM emits tool_call  ->  Plugin executes locally  ->  POST /tool-result  ->  LLM continues or responds\nPlugin is the single source of truth for all tools — backend discovers them dynamically on every request",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chat Flow:  User  ->  Plugin  ->  Backend (builds prompt)  ->  LLM  ->  Backend  ->  Plugin (SSE stream)  ->  User\nTool Loop:  LLM emits tool_call  ->  Plugin executes locally  ->  POST /tool-result  ->  LLM continues or responds\nPlugin is the single source of truth for all tools — backend discovers them dynamically on every request",
      "autoResize": true,
      "lineHeight": 1.25
    }
